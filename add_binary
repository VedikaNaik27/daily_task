#include <stdlib.h>
#include <string.h>

char* addBinary(char* a, char* b) {
    int i = strlen(a) - 1;
    int j = strlen(b) - 1;
    int carry = 0;
    int n = (i > j ? i : j) + 2;

    char* ans = malloc(n);
    ans[n - 1] = '\0';

    int k = n - 2;

    while (i >= 0 || j >= 0 || carry) {
        int sum = carry;

        if (i >= 0) sum += a[i--] - '0';
        if (j >= 0) sum += b[j--] - '0';

        ans[k--] = (sum % 2) + '0';
        carry = sum / 2;
    }

    if (k >= 0)
        return strcpy(ans, ans + k + 1);

    return ans;
}
