int* sortedSquares(int* nums, int numsSize, int* returnSize) {
    int *res = malloc(numsSize * sizeof(int));
    int left = 0, right = numsSize - 1;

    *returnSize = numsSize;

    for (int i = numsSize - 1; i >= 0; i--) {
        int l = nums[left] * nums[left];
        int r = nums[right] * nums[right];

        if (l > r) {
            res[i] = l;
            left++;
        } else {
            res[i] = r;
            right--;
        }
    }

    return res;
}
